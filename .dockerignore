# Everything here is excluded from the build context, which is uploaded to the
# daemon on every build. Smaller context = faster builds and fewer spurious
# cache invalidations.
.git
.github
.gitignore
.gitattributes
docs
*.md
.env
.env.*
bin
dist
node_modules
web/dist
compose.yaml
Dockerfile
.dockerignore

# The frontend SOURCE is needed (the web stage builds it) but its dependencies
# are not -- `npm ci` reinstalls them inside the image, and shipping a host
# node_modules into the context is both enormous and platform-wrong.
web/node_modules
internal/webui/dist
